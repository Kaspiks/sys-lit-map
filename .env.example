# Copy to .env and fill in. .env is git-ignored.

# Your email: sent to NCBI (required by Entrez), Crossref (polite pool) and OpenAlex.
CONTACT_EMAIL=you@example.com

# NCBI / PubMed: optional, raises limit from 3 to 10 requests/sec.
# Get one at https://account.ncbi.nlm.nih.gov/settings/ (API Key Management)
NCBI_API_KEY=

# OpenAlex: free key, ~10x the daily allowance of keyless use.
# Get one at https://openalex.org (account settings)
OPENALEX_API_KEY=

# Europe PMC and Crossref need no key.
